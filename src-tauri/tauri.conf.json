{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GalFriends",
  "version": "0.1.1",
  "identifier": "com.galfriends.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GalFriends",
        "width": 1240,
        "height": 820,
        "minWidth": 1122,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#FFFFFF",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: https://lain.bgm.tv https://image.kungal.iloveren.link; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../tools/waifu2x/": "tools/waifu2x/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../web/assets/setsuna/": "sample/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Galgame 角色资料与立绘收藏",
    "license": "GPL-3.0-only"
  }
}
